    "db:verify": "node scripts/verify-database-schema.js",
    "admin:promote": "node scripts/promote-admin.js",
    "admin:bootstrap": "node scripts/bootstrap-admin.js",
    "test": "node --test frontend/tests/*.test.mjs backend/tests/*.test.js"
