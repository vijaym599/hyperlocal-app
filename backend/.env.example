PORT=5000
NODE_ENV=development
# Leave false for direct access. Set trusted proxy IPs/subnets in production;
# a hop count (e.g. 1) is safe only if all traffic must traverse that proxy.
TRUST_PROXY=false
# Public website origin. The reverse proxy must send /, /shop/*, /product/*,
# /shops, /sitemap.xml, /sitemaps/*, /robots.txt and /assets/* to this backend.
SITE_URL=https://yourdomain.in
DB_USER=postgres
DB_HOST=localhost
DB_NAME=nearbuy
DB_PASSWORD=replace-me
DB_PORT=5432
# Optional hosted database URL, used instead of DB_USER/HOST/NAME/PASSWORD/PORT.
DATABASE_URL=
# Enable certificate verification for hosted PostgreSQL. Keep false for local DB.
# Do not combine DB_SSL=true with SSL parameters in DATABASE_URL.
DB_SSL=false
# Optional provider CA certificate (PEM; literal \n escapes are supported).
DB_SSL_CA=
JWT_SECRET=replace-with-a-long-random-secret
# WhatsApp OTP. Production supports Twilio Verify; account signup remains blocked
# until these values are configured. "development" is refused in production.
PHONE_OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Local-only alternative: PHONE_OTP_PROVIDER=development
DEVELOPMENT_OTP_CODE=123456
CORS_ORIGIN=https://app.example.com
GEOCODER_USER_AGENT=Nearbuy/1.0 (support@example.com)

# Timezone used by the server to maintain shop opening schedules.
SHOP_TIMEZONE=Asia/Kolkata
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_GEOCODER_BASE_URL=https://photon.komoot.io
